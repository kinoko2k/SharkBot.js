// This is your Prisma schema file.
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Counting {
  guildId        String
  channelId      String
  now            Int      @default(0)
  resetOnMistake Boolean  @default(true)

  @@id([guildId, channelId])
}

model UserNote {
  id           Int      @id @default(autoincrement())
  guildId      String
  targetUserId String
  authorId     String
  content      String
  createdAt    DateTime @default(now())
}

model TimeSignal {
  guildId   String @id
  channelId String
}

model GuildSetting {
  guildId       String  @id
  muteRoleId    String?
  protectDm     Boolean @default(false)
  protectInvite Boolean @default(false)
}
